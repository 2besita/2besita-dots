[global]
    monitor = 0
    follow = none

    width = 420
    height = (30, 300)
    origin = bottom-right
    offset = (40, 40)
    scale = 1
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 

    separator_height = 1
    padding = 12
    horizontal_padding = 24
    text_icon_padding = 24
    frame_width = 2
    frame_color = "#404040"
    separator_color = frame
    sort = yes

    font = Terminess Nerd Font Mono 14
    line_height = 0
    markup = full
    format = "<span color='#c3d9ac'><b>%s</b></span>\n<span color='#f2f2f2'>%b</span>"
    alignment = top-lef333131
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 64
    max_icon_size = 64

    sticky_history = yes
    history_length = 5

    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 0
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#212020"
    foreground = "#f2f2f2"
    frame_color = "#404040"
    highlight = "#c3d9ac"
    timeout = 5
    default_icon = dialog-information

[urgency_normal]
    background = "#212020"
    foreground = "#f2f2f2"
    frame_color = "#404040"
    highlight = "#c3d9ac"
    timeout = 8
    default_icon = dialog-information

[urgency_critical]
    background = "#212020"
    foreground = "#f2f2f2"
    frame_color = "#404040"
    highlight = "#c3d9ac"
    timeout = 0
    default_icon = dialog-error

[volume]
    appname = "volume"
    background = "#212020"
    foreground = "#f2f2f2"
    frame_color = "#404040"
    timeout = 2
    format = "<span color='#c3d9ac'><b>%s</b></span>\n<span color='#c3d9ac'>%b</span>"

[brightness]
    appname = "brightness"
    background = "#212020"
    foreground = "#f2f2f2"
    frame_color = "#404040"
    timeout = 2
    format = "<span color='#c3d9ac'><b>%s</b></span>\n<span color='#c3d9ac'>%b</span>"

[system]
    appname = "systemd"
    background = "#212020"
    foreground = "#f2f2f2"
    frame_color = "#404040"
    timeout = 6
